<Window x:Class="CyberTools.View.Wifi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberTools.View"
        mc:Ignorable="d"
        Title="CyberTools" Height="800" Width="1200"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown"
        Icon="pack://application:,,,/Images/CyberTools.ico">

    <Border Background="White" CornerRadius="20">
        <Border.Clip>
            <RectangleGeometry Rect="0,0,1200,800" RadiusX="15" RadiusY="15"/>
        </Border.Clip>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Rectangle Fill="#2962FF" Width="250" Height="800" HorizontalAlignment="Left" />

                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="CyberTools" FontSize="28" FontWeight="Bold" Foreground="White" 
                              HorizontalAlignment="Center" Margin="0,0,0,40"/>

                    <Button x:Name="Main" Content="Main Page" Height="60" Margin="20,0,20,15" 
                           FontSize="18" Foreground="White" Click="Main_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1E56DB"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0D47A1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="Keylogger" Content="Keylogger" Height="60" Margin="20,0,20,15" 
                           FontSize="18" Foreground="White" Click="Keylogger_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1E56DB"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0D47A1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="Wifideauth" Content="WiFi Deauthenticate" Height="60" Margin="20,0,20,15" 
                           FontSize="18" Foreground="White" Click="Wifi_Click" Background="#4778FA">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0D47A1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <TextBlock Text="v1.1.0" Foreground="White" HorizontalAlignment="Center" 
                          VerticalAlignment="Bottom" Margin="0,0,0,20" Opacity="0.7"/>
            </Grid>

            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0">
                    <Button x:Name="MinimizeButton" Content="−" Width="40" Height="40" Click="MinimizeButton_Click" 
                           Margin="0,0,10,0" FontSize="16" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DDDDDD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="CloseButton" Content="×" Width="40" Height="40" Click="CloseButton_Click" 
                           FontSize="20" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FF5252"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Grid Margin="30,70,30,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="WiFi Deauthentication Tool" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Network Interface Selection" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ComboBox x:Name="NetworkInterfacesComboBox" Height="36" Margin="0,0,20,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <Button x:Name="ScanNetworksButton" Content="Scan Networks" Height="36" Width="160" Margin="0,0,0,9" Click="ScanNetworksButton_Click">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Background" Value="#2962FF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0D47A1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ScanStatusText" Grid.Row="1" Text="" FontStyle="Italic" Margin="0,50,0,10"/>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F5F7FA" CornerRadius="8" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Available Networks" FontSize="16" FontWeight="SemiBold" Margin="15,15,0,15"/>

                                <ListView x:Name="NetworksListView" Grid.Row="1" Margin="10,0,10,10" 
                                         SelectionMode="Single" SelectionChanged="NetworksListView_SelectionChanged" 
                                         BorderThickness="0" Background="Transparent">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="SSID" DisplayMemberBinding="{Binding SSID}" Width="140"/>
                                            <GridViewColumn Header="BSSID (MAC)" DisplayMemberBinding="{Binding BSSID}" Width="140"/>
                                            <GridViewColumn Header="Channel" DisplayMemberBinding="{Binding Channel}" Width="70"/>
                                            <GridViewColumn Header="Signal" DisplayMemberBinding="{Binding SignalStrength}" Width="60"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="#F5F7FA" CornerRadius="8" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Connected Clients" FontSize="16" FontWeight="SemiBold" Margin="15,15,0,15"/>

                                <ListView x:Name="ClientsListView" Grid.Row="1" Margin="10,0,10,10" 
                                         SelectionMode="Multiple" BorderThickness="0" Background="Transparent">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="MAC Address" DisplayMemberBinding="{Binding MacAddress}" Width="140"/>
                                            <GridViewColumn Header="Signal" DisplayMemberBinding="{Binding SignalStrength}" Width="60"/>
                                            <GridViewColumn Header="Last Seen" DisplayMemberBinding="{Binding LastSeen}" Width="100"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Background="#F5F7FA" CornerRadius="8" Margin="0,20,0,0" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Attack Configuration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                                <CheckBox x:Name="TargetAllClientsCheckBox" Content="Target All Clients" IsChecked="True" Margin="0,0,0,15">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="FontSize" Value="14"/>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="Number of Packets:" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="14"/>
                                    <ComboBox x:Name="PacketCountComboBox" Width="120" Height="32" SelectedIndex="2">
                                        <ComboBoxItem Content="10"/>
                                        <ComboBoxItem Content="50"/>
                                        <ComboBoxItem Content="100"/>
                                        <ComboBoxItem Content="500"/>
                                        <ComboBoxItem Content="Continuous"/>
                                    </ComboBox>
                                </StackPanel>

                                <ProgressBar x:Name="AttackProgressBar" Height="6" Maximum="100" Visibility="Collapsed" Margin="0,5,0,5"/>
                                <TextBlock x:Name="AttackStatusText" Text="" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="StartAttackButton" Content="Start Deauthentication" Width="200" Height="50" Click="StartAttackButton_Click" Margin="20,0,0,10">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#FF5252"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D32F2F"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="StopAttackButton" Content="Stop Attack" Width="200" Height="50" Click="StopAttackButton_Click" IsEnabled="False" Margin="20,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#757575"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#616161"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="3" Text="WARNING: Use only on networks you own or have permission to test. Unauthorized use may be illegal." 
                              Foreground="#D32F2F" TextWrapping="Wrap" HorizontalAlignment="Center" 
                              VerticalAlignment="Bottom" Margin="0,0,0,-30" FontSize="12"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>